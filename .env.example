# ═══════════════════════════════════════════
# EventRent.az — Production Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# Server
PORT=4320
NODE_ENV=production

# JWT — set a long random string, never expose publicly
JWT_SECRET=change_this_to_a_long_random_secret

# Database path (relative to project root)
DB_PATH=data/eventrent.db

# Site URL — used in WhatsApp messages (tracking links etc.)
SITE_URL=https://eventrent.az

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://eventrent.az,https://www.eventrent.az

# WhatsApp owner phone (with country code, no +)
OWNER_WA_PHONE=994XXXXXXXXX

# SMTP (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=EventRent <your@gmail.com>

# Admin emails
VITE_ADMIN_EMAILS=admin@eventrent.az