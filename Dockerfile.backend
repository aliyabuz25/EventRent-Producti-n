FROM node:20-alpine
WORKDIR /app
# native build tools (better-sqlite3 üçün)
RUN apk add --no-cache python3 make g++
# yalnız backend package.json istifadə et
COPY package.backend.json ./package.json
RUN npm install
COPY server.js ./
COPY data/ ./data/
RUN mkdir -p uploads
ENV HOST=0.0.0.0
ENV PORT=4320
EXPOSE 4320
CMD ["node", "server.js"]