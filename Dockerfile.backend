FROM node:22-slim

WORKDIR /app

# native build tools (better-sqlite3, baileys için)
RUN apt-get update && apt-get install -y python3 make g++ git && rm -rf /var/lib/apt/lists/*

# Sadece backend paketlerini yükle
COPY package.backend.json ./package.json
RUN npm install

# Server dosyasını kopyala
COPY server.js ./

# Data klasörlerini boş oluştur (Volume mount edilecek)
RUN mkdir -p data uploads

ENV HOST=0.0.0.0
ENV PORT=4320
EXPOSE 4320
CMD ["node", "server.js"]