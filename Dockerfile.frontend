# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
# Hata vermesini önlemek için --legacy-peer-deps veya npm install yerine:
RUN npm install --legacy-peer-deps || npm cache clean --force && npm install --legacy-peer-deps

COPY . .
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /app/nginx-logs
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 80